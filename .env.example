APP_NAME=TradeIQ API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Local Python execution can omit DATABASE_URL to use SQLite.
# Docker Compose overrides this with PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+psycopg://tradeiq:replace-with-a-local-database-password@localhost:5432/tradeiq
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MARKET_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TRADING_MODE=simulation
TRADING_ENABLED=false
DEMO_MODE=true
MARKET_DATA_PROVIDER=yahoo
ALPACA_BASE_URL=https://paper-api.alpaca.markets
MIN_PAPER_BALANCE=100
MAX_PAPER_BALANCE=10000000
DEFAULT_PAPER_BALANCE=10000
